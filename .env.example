# Public canonical URL used by metadata, robots, and sitemap.
NEXT_PUBLIC_SITE_URL=https://example.com

# Server-only Resend credential. Never prefix this with NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# A verified sender in your Resend account, e.g. Canary Labs <hello@yourdomain.com>
CONTACT_FROM_EMAIL=Canary Labs <hello@example.com>
